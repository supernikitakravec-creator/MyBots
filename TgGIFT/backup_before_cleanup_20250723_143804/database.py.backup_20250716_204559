    def get_user_gifts(self, user_id: int) -> List[Dict]:
        """Возвращает список купленных пользователем подарков"""
        if not self._validate_user_id(user_id):
            return []
        try:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                cursor.execute('''
                    SELECT g.name, p.price_stars, p.status, p.purchase_date
                    FROM purchases p
                    JOIN gifts g ON p.gift_id = g.gift_id
                    WHERE p.user_id = ?
                    ORDER BY p.purchase_date DESC
                ''', (user_id,))
                gifts = []
                for row in cursor.fetchall():
                    gifts.append({
                        'name': row[0],
                        'price_stars': row[1],
                        'status': row[2] if row[2] else 'Куплен',
                        'purchase_date': row[3]
                    })
                return gifts
        except Exception as e:
            logger.error(f"Ошибка получения купленных подарков пользователя {user_id}: {e}")
            return []
    
    def get_user_transactions(self, user_id: int, limit: int = 10) -> List[Dict]:
        """Возвращает историю транзакций пользователя"""
        if not self._validate_user_id(user_id):
            return []
        try:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                cursor.execute('''
                    SELECT transaction_type, amount, description, timestamp
                    FROM transactions
                    WHERE user_id = ?
                    ORDER BY timestamp DESC
                    LIMIT ?
                ''', (user_id, limit))
                transactions = []
                for row in cursor.fetchall():
                    # Определяем тип операции для отображения
                    operation_type = "Пополнение" if row[1] > 0 else "Списание"
                    transactions.append({
                        'type': row[0],
                        'amount': row[1],
                        'description': row[2] if row[2] else 'Операция',
                        'timestamp': row[3],
                        'operation_type': operation_type
                    })
                return transactions
        except Exception as e:
            logger.error(f"Ошибка получения истории транзакций пользователя {user_id}: {e}")
            return []
    
    def add_notification(self, user_id: int, message: str, notification_type: str) -> bool:
        """Добавление уведомления для пользователя"""
        if not self._validate_user_id(user_id):
            return False
        
        try:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                
                cursor.execute('''
                    INSERT INTO notifications (user_id, message, type, is_sent)
                    VALUES (?, ?, ?, FALSE)
                ''', (user_id, message, notification_type))
                
                conn.commit()
                logger.info(f"Уведомление добавлено для пользователя {user_id}")
                return True
                
        except Exception as e:
            logger.error(f"Ошибка добавления уведомления: {e}")
            return False
    
    def get_pending_notifications(self, user_id: int) -> List[Dict]:
        """Получение непрочитанных уведомлений пользователя"""
        if not self._validate_user_id(user_id):
            return []
        
        try:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                
                cursor.execute('''
                    SELECT id, message, type, created_at
                    FROM notifications
                    WHERE user_id = ? AND is_sent = FALSE
                    ORDER BY created_at ASC
                ''', (user_id,))
                
                notifications = []
                for row in cursor.fetchall():
                    notifications.append({
                        'id': row[0],
                        'message': row[1],
                        'type': row[2],
                        'created_at': row[3]
                    })
                
                return notifications
                
        except Exception as e:
            logger.error(f"Ошибка получения уведомлений: {e}")
            return []
    
    def mark_notification_sent(self, notification_id: int) -> bool:
        """Отметить уведомление как отправленное"""
        try:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                
                cursor.execute('''
                    UPDATE notifications
                    SET is_sent = TRUE, sent_at = datetime('now')
                    WHERE id = ?
                ''', (notification_id,))
                
                conn.commit()
                return True
                
        except Exception as e:
            logger.error(f"Ошибка отметки уведомления: {e}")
            return False
    
    def cleanup_expired_subscriptions(self):
        """Очистка истекших подписок"""
        try:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                
                cursor.execute('''
                    UPDATE subscriptions 
                    SET is_active = FALSE 
                    WHERE is_active = TRUE AND end_date <= datetime('now')
                ''')
                
                affected_rows = cursor.rowcount
                if affected_rows > 0:
                    conn.commit()
                    logger.info(f"Деактивировано {affected_rows} истекших подписок")
                
        except Exception as e:
            logger.error(f"Ошибка очистки истекших подписок: {e}")
    
    def get_database_stats(self) -> Dict:
        """Получение статистики базы данных"""
        try:
            with self.get_connection() as conn:
                cursor = conn.cursor()
                
                stats = {}
                
                # Количество пользователей
                cursor.execute('SELECT COUNT(*) FROM users WHERE is_active = TRUE')
                stats['total_users'] = cursor.fetchone()[0]
                
                # Количество активных подписок
                cursor.execute('SELECT COUNT(*) FROM subscriptions WHERE is_active = TRUE')
                stats['active_subscriptions'] = cursor.fetchone()[0]
                
                # Размер очереди
                cursor.execute('SELECT COUNT(*) FROM purchase_queue WHERE is_active = TRUE')
                stats['queue_size'] = cursor.fetchone()[0]
                
                # Количество подарков
                cursor.execute('SELECT COUNT(*) FROM gifts WHERE is_available = TRUE')
                stats['available_gifts'] = cursor.fetchone()[0]
                
                return stats
                
        except Exception as e:
            logger.error(f"Ошибка получения статистики БД: {e}")
            return {} 